# This pkg-config file is generated by ecbuild_pkgconfig()
# with template ecbuild/cmake/pkg-config.pc.in

git_tag=11fa27c9a9186ca5edf87333c14d1c38119487be

prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include
bindir=${prefix}/bin
fmoddir=${prefix}/include

CC=/usr/bin/cc
CXX=/usr/bin/c++
FC=

libs=-Wl,-rpath,${libdir} -L${libdir} -leckit_spec

libs_private=-Wl,-rpath,${libdir} -L${libdir} -leckit -Wl,-rpath,/opt/ecmwf/stack-deps/lib -L/opt/ecmwf/stack-deps/lib -llz4 -Wl,-rpath,/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/lib -L/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/lib -lbz2 -lcurl -l$<0:LibUUID -l$<0:LibOPENFAM -l$<0:libaec::aec -lm

cflags=-I${includedir} -I/tmp/eckit/target/eckit/include -I/tmp/eckit/target/eckit/include/eckit/spec

#====================================================================
Name: eckit_spec
Description: ECMWF C++ Toolkit - eckit_spec library
URL: https://software.ecmwf.int/wiki/display/ECKIT/ecKit
Version: 2.5.0
Libs: ${libs}
Libs.private: ${libs_private}
Requires: 
Requires.private: 
Cflags: ${cflags}
#====================================================================
